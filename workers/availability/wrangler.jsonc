{
  "name": "x402id-availability",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // @coinbase/x402 reads process.env and signs CDP JWTs with node crypto.
  "compatibility_flags": ["nodejs_compat"],
  // KEEP workers_dev true. The workers.dev URL is cataloged in Bazaar/agentic.market,
  // listed in ERC-8004 agent 8453:98739 and in the org.x402.origins of x402id.402api.eth
  // (the payee) and test.402api.eth (the old payee, kept for existing checks).
  // api.x402id.dev is an ADDED hostname, never a replacement.
  "workers_dev": true,
  "routes": [{ "pattern": "api.x402id.dev", "custom_domain": true }],
  // 30 /v1/challenge reads per minute per IP.
  "ratelimits": [
    { "name": "CHALLENGE_LIMITER", "namespace_id": "4021", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "PUBLIC_URL": "https://x402id-availability.dmpay.workers.dev"
  }
  // Secrets (wrangler secret put …) — never commit them:
  //   CDP_API_KEY_ID, CDP_API_KEY_SECRET  — CDP facilitator (Base mainnet + Bazaar)
  //   MAINNET_RPC_URL (optional)          — server-side RPC; public RPCs are the fallback
}
